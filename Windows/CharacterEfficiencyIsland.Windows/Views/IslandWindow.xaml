<Window x:Class="CharacterEfficiencyIsland.Windows.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
  <Viewbox x:Name="IslandScaleHost"
           Stretch="Uniform"
           StretchDirection="Both">
    <Grid x:Name="IslandRoot">
      <Border x:Name="IslandBody"
            CornerRadius="22"
            Background="#D0929292"
            BorderBrush="Transparent"
            BorderThickness="0"
            MouseLeftButtonDown="IslandBody_OnMouseLeftButtonDown"
            MouseEnter="IslandBody_OnMouseEnter"
            MouseLeave="IslandBody_OnMouseLeave">
      <Grid>
        <Grid x:Name="HorizontalLayout" Margin="14,6,8,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="62" />
          </Grid.ColumnDefinitions>
          <Viewbox Grid.Column="0" Width="23" Height="23" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Canvas Width="28" Height="28">
              <Ellipse Canvas.Left="3" Canvas.Top="4" Width="22" Height="22" Stroke="#FFFF3B43" StrokeThickness="3" />
              <Line X1="14" Y1="1" X2="14" Y2="7" Stroke="#FFFF3B43" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              <Line X1="14" Y1="15" X2="9" Y2="10" Stroke="#FFFF3B43" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
          </Viewbox>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
            <TextBlock x:Name="HorizontalTitle" Foreground="White" FontSize="16.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="HorizontalDetail" Foreground="#DFFFFFFF" FontSize="11.5" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Image x:Name="HorizontalImage" Grid.Column="2" Stretch="Uniform" Margin="3,-4,0,-4" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <Grid x:Name="VerticalLayout" Visibility="Collapsed" Margin="8,12,8,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="104" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="VerticalTitle"
                     Grid.Row="0"
                     Foreground="White"
                     FontSize="14"
                     FontWeight="Bold"
                     TextAlignment="Center"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     LineHeight="16" />
          <StackPanel Grid.Row="1"
                      Width="88"
                      HorizontalAlignment="Center"
                      Margin="0,5,0,8">
            <TextBlock x:Name="VerticalTimeLabel"
                       Text="工作时间"
                       Foreground="#DFFFFFFF"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       TextAlignment="Center" />
            <TextBlock x:Name="VerticalTimer"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="Bold"
                       FontFamily="Consolas"
                       TextAlignment="Center"
                       Margin="0,1" />
            <TextBlock x:Name="VerticalEpm"
                       Foreground="#DFFFFFFF"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       TextAlignment="Center" />
          </StackPanel>
          <Image x:Name="VerticalImage" Grid.Row="2" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
        </Grid>
      </Grid>
      </Border>

      <primitives:Thumb x:Name="ResizeThumb"
                      Width="15"
                      Height="15"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Cursor="SizeNWSE"
                      Opacity="0.01"
                      DragStarted="ResizeThumb_OnDragStarted"
                      DragDelta="ResizeThumb_OnDragDelta"
                        DragCompleted="ResizeThumb_OnDragCompleted" />
    </Grid>
  </Viewbox>
</Window>
