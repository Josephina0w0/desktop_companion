<Window x:Class="CharacterEfficiencyIsland.Windows.Views.CompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
  <Grid MouseLeftButtonDown="Root_OnMouseLeftButtonDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="104" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Margin="8,4,8,0"
            Padding="13,9"
            Background="#EBFFFFFF"
            BorderBrush="#33000000"
            BorderThickness="1"
            CornerRadius="17">
      <StackPanel>
        <TextBlock x:Name="BubbleTitle" FontSize="16" FontWeight="Bold" Foreground="#202020" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="BubbleDetail" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" MaxHeight="48" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <Image x:Name="CharacterImage"
           Grid.Row="1"
           Stretch="Uniform"
           HorizontalAlignment="Center"
           VerticalAlignment="Bottom" />

    <primitives:Thumb x:Name="ResizeThumb"
                      Grid.RowSpan="2"
                      Width="24"
                      Height="24"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Cursor="SizeNWSE"
                      Opacity="0.01"
                      DragStarted="ResizeThumb_OnDragStarted"
                      DragDelta="ResizeThumb_OnDragDelta"
                      DragCompleted="ResizeThumb_OnDragCompleted" />
  </Grid>
</Window>
